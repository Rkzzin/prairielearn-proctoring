# =============================================================================
#  proctor-station — configuracao
#  Copie este arquivo para .env e preencha os valores.
#
#    cp .env.example .env
#
#  Variaveis de ambiente tem prioridade sobre o .env.
#  Nunca versione o .env (ja esta no .gitignore).
# =============================================================================


# -----------------------------------------------------------------------------
#  AWS — credenciais e regiao
#  Alternativa: configure via ~/.aws/credentials ou IAM role na instancia/NUC
#  em vez de preencher aqui.
# -----------------------------------------------------------------------------

# PREENCHER: access key de um usuario/role IAM com permissao de leitura em
# {bucket}/{PROCTOR_S3_PHOTOS_PREFIX}/* e leitura+escrita em
# {bucket}/{PROCTOR_S3_RECORDINGS_PREFIX}/* (GetObject/PutObject/ListBucket
# no bucket configurado abaixo). Sem isso, /health reporta s3_ok=false e
# POST /session/start falha.
AWS_ACCESS_KEY_ID=
# PREENCHER: secret key correspondente à access key acima.
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=sa-east-1


# -----------------------------------------------------------------------------
#  S3 — bucket e prefixos
# -----------------------------------------------------------------------------

# Nome do bucket S3
PROCTOR_S3_BUCKET=proctor-station

# Regiao do bucket (deve coincidir com AWS_DEFAULT_REGION)
PROCTOR_S3_REGION=sa-east-1

# Prefixo onde ficam as fotos de cadastro dos alunos
# Estrutura: s3://{bucket}/{PHOTOS_PREFIX}/{turma_id}/{nome_aluno}.png
PROCTOR_S3_PHOTOS_PREFIX=fotos

# Prefixo onde ficam as gravacoes de prova
PROCTOR_S3_RECORDINGS_PREFIX=gravacoes

# Duracao de cada segmento de gravacao (segundos)
PROCTOR_S3_SEGMENT_DURATION_SEC=300


# -----------------------------------------------------------------------------
#  Face — modelos dlib e parametros de reconhecimento
# -----------------------------------------------------------------------------

# Diretorio com os arquivos .dat do dlib (baixados por download_models.sh)
PROCTOR_FACE_MODELS_DIR=models

# Diretorio local onde os .pkl de encodings sao salvos
PROCTOR_FACE_ENCODINGS_DIR=data/encodings

# Distancia euclidiana maxima para considerar match
# Menor = mais restritivo. Valores tipicos: 0.4 (estrito) a 0.6 (permissivo)
PROCTOR_FACE_MATCH_THRESHOLD=0.45

# Usar detector CNN (requer GPU) em vez de HOG (CPU)
# true apenas se a NUC tiver GPU compativel com dlib/CUDA
PROCTOR_FACE_USE_CNN_DETECTOR=false

# Maximo de tentativas de identificacao antes de pedir intervencao manual
PROCTOR_FACE_MAX_IDENTIFICATION_ATTEMPTS=3

# Indice da camera USB (/dev/videoN)
PROCTOR_FACE_CAMERA_INDEX=0
PROCTOR_FACE_CAMERA_WIDTH=1280
PROCTOR_FACE_CAMERA_HEIGHT=720
PROCTOR_FACE_CAMERA_FPS=30

# Fator de escala do frame antes da deteccao (performance)
# 0.5 = processar em metade da resolucao (recomendado para CPU)
PROCTOR_FACE_DETECTION_SCALE=0.5

# Jitters por encoding durante identificacao
# Use 1 para velocidade, 3-5 para maior precisao
PROCTOR_FACE_NUM_JITTERS=1


# -----------------------------------------------------------------------------
#  Proctoring engine — limiares de comportamento
# -----------------------------------------------------------------------------

# Desvio horizontal do olhar para acionar alerta (0.0 a 1.0)
PROCTOR_GAZE_H_THRESHOLD=0.35

# Desvio vertical do olhar para acionar alerta (0.0 a 1.0)
PROCTOR_GAZE_V_THRESHOLD=0.30

# Segundos com olhar desviado antes de registrar evento
PROCTOR_GAZE_DURATION_SEC=5.0

# Segundos sem rosto detectado antes de registrar ausencia
PROCTOR_ABSENCE_TIMEOUT_SEC=5.0

# Bloquear sessao ao detectar multiplos rostos
PROCTOR_MULTI_FACE_BLOCK=true


# -----------------------------------------------------------------------------
#  App — API local e tela de inicio da identificacao
# -----------------------------------------------------------------------------

# Porta da API REST local da NUC
PROCTOR_APP_API_PORT=8000

# Nivel de log: DEBUG | INFO | WARNING | ERROR
PROCTOR_APP_LOG_LEVEL=INFO

# Diretorio de dados locais (logs, temporarios, sessoes)
PROCTOR_APP_DATA_DIR=/opt/proctor/data

# Legado: intervalo do antigo loop de auto-start (não usado no fluxo manual)
PROCTOR_APP_AUTO_START_POLL_SEC=2.0

# Legado: mantido por compatibilidade, mas a identificacao agora comeca somente
# quando o aluno clica em "Iniciar prova" no overlay local.
PROCTOR_APP_AUTO_START_ENABLED=true

# Persiste a ultima configuracao e restaura o modo prova apos reiniciar a NUC
PROCTOR_APP_PERSIST_SESSION_CONFIG=true
PROCTOR_APP_RESTORE_EXAM_MODE_ON_STARTUP=true

# OPCIONAL. Se preenchido, TODO o trafego do Chromium da prova (so o
# Chromium, nao o SO) passa por este proxy (--proxy-server). Deixe vazio
# para o Chromium sair direto — nunca deixe como "None" nem qualquer texto
# que nao seja uma URL de proxy valida, isso quebra a navegacao inteira.
# Formato: http://<host>:<porta>
PROCTOR_APP_PROXY_SERVER=


# -----------------------------------------------------------------------------
#  Gravacao — FFmpeg, preview local e captura de tela
# -----------------------------------------------------------------------------

# Display X11 usado pelo Chromium/desktop capturado por x11grab.
# A sessão Matchbox com autologin usa o primeiro display X11.
PROCTOR_REC_DISPLAY=:0

# Resolucao final do video de tela; a resolucao real do display e detectada via xrandr
PROCTOR_REC_SCREEN_SIZE=1280x720

# Formato V4L2 da webcam para o FFmpeg
PROCTOR_REC_WEBCAM_INPUT_FORMAT=mjpeg

# Audio ambiente gravado apenas no video principal. A fonte abaixo e o
# microfone interno do notebook; detect_camera_audio.sh confirma/preenche.
PROCTOR_REC_WEBCAM_AUDIO_ENABLED=true
PROCTOR_REC_WEBCAM_AUDIO_INPUT_FORMAT=pulse
PROCTOR_REC_WEBCAM_AUDIO_DEVICE=alsa_input.pci-0000_00_1f.3.analog-stereo
PROCTOR_REC_WEBCAM_AUDIO_BITRATE=96k
PROCTOR_REC_WEBCAM_AUDIO_FILTER=highpass=f=80,alimiter=limit=0.891:level=false
PROCTOR_REC_WEBCAM_AUDIO_ALSA_CARD=0
PROCTOR_REC_WEBCAM_AUDIO_CAPTURE_PERCENT=30

# Remove segmentos locais depois de upload S3 bem-sucedido
PROCTOR_REC_DELETE_AFTER_UPLOAD=true

# Threads x264 por stream FFmpeg
PROCTOR_REC_FFMPEG_THREADS=1

# Preview MPEG-TS local consumido pelo OpenCV para gaze/reidentificacao
PROCTOR_REC_PREVIEW_HOST=127.0.0.1
PROCTOR_REC_PREVIEW_PORT=18181
PROCTOR_REC_PREVIEW_WIDTH=640
PROCTOR_REC_PREVIEW_HEIGHT=360
PROCTOR_REC_PREVIEW_FPS=10

# OPCIONAL — deixe em branco na maioria dos casos. Se vazio e a maquina tiver
# 4+ CPUs, o SessionManager reserva automaticamente os dois ultimos nucleos
# para o FFmpeg. So preencha a mao (ex: '4-6' e '0-3') se souber o numero
# exato de nucleos desta maquina especifica (confira com `nproc`) — um valor
# copiado de outra maquina com CPU diferente falha silenciosamente e a
# afinidade nao e aplicada.
PROCTOR_REC_FFMPEG_CPU_CORES=
PROCTOR_REC_PROCTOR_CPU_CORES=


# -----------------------------------------------------------------------------
#  Dashboard — heartbeat da NUC para o painel do professor
# -----------------------------------------------------------------------------

# Ativar sincronizacao NUC -> dashboard
PROCTOR_DASHBOARD_ENABLED=false

# URL base do dashboard central
PROCTOR_DASHBOARD_BASE_URL=http://127.0.0.1:8010

# Intervalo entre heartbeats (segundos)
PROCTOR_DASHBOARD_HEARTBEAT_INTERVAL_SEC=5.0

# Timeout HTTP das chamadas ao dashboard
PROCTOR_DASHBOARD_TIMEOUT_SEC=5.0

# Identificacao da estacao no dashboard.
# OBRIGATORIO trocar em cada maquina — se duas estacoes usarem o mesmo
# station_id elas se sobrescrevem no dashboard (e ficam como uma so).
PROCTOR_DASHBOARD_STATION_ID=nuc-local
PROCTOR_DASHBOARD_STATION_NAME=NUC Local

# Login do PROFESSOR no painel (usuario/senha, Basic Auth) — so o DASHBOARD
# usa isto. A senha e hasheada (PBKDF2) e gravada no Postgres no primeiro
# boot; depois disso PROCTOR_DASHBOARD_ADMIN_PASSWORD pode ser removida do
# .env, so o hash no banco importa.
# Sem essas duas variaveis no dashboard, o painel fica acessivel sem senha —
# so pule isto em teste local isolado da rede.
# Nao preencher nas NUCs — isto nao autentica heartbeat/sessao, ver
# PROCTOR_DASHBOARD_STATION_TOKEN abaixo.
PROCTOR_DASHBOARD_ADMIN_USER=
PROCTOR_DASHBOARD_ADMIN_PASSWORD=

# Token desta ESTACAO (NUC) — so a NUC usa isto, autentica heartbeat/sessao
# contra o dashboard. NAO e a senha do professor: e emitido no dashboard,
# uma vez por estacao, via `python scripts/issue_station_token.py <station_id>`
# (ver docs/setup_dashboard.md). Cole aqui o token impresso na hora da
# emissao — nao fica recuperavel depois, so o hash fica no Postgres.
# Sem isto (ou com token errado), o heartbeat recebe 401 e a estacao nunca
# aparece no painel — nao e um erro silencioso, mas so aparece no log
# (journalctl -u proctor -f), nao na UI.
PROCTOR_DASHBOARD_STATION_TOKEN=

# DSN do Postgres que guarda o estado do dashboard (estacoes, sessoes,
# enrollments, configs, credenciais). So o DASHBOARD usa — nao tem efeito
# nenhum na NUC, pode ficar em branco la.
# OBRIGATORIO no dashboard: sem isso o processo nao sobe (falha no boot com
# mensagem clara, nao silenciosa). Ver docs/setup_dashboard.md para como
# provisionar o banco/role antes de preencher isto.
# Exemplo local (docker-compose.yml sobe um Postgres em 127.0.0.1:5432):
#   PROCTOR_DASHBOARD_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/proctor_dashboard
PROCTOR_DASHBOARD_DATABASE_URL=
